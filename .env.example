# ShopSphere Environment Variables Configuration Template
# Copy this file to .env or set environment variables in your deployment

# Database Configuration (PostgreSQL 18)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shopsphere_db
SPRING_DATASOURCE_USERNAME=shopsphere_user
SPRING_DATASOURCE_PASSWORD=shopsphere_pass

# Backend Port
SERVER_PORT=8080

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security (JWT Secrets will be configured in Milestone 2)
JWT_SECRET=super_secret_jwt_key_must_be_at_least_256_bits_long_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# AI Features (Optional: provide Gemini API key for live LLM generation, or leave blank for local RAG concierge)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

